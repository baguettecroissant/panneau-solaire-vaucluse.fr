---
const {compact=false,city=''}=Astro.props;
const titleCity=city?`à ${city}`:'dans le Vaucluse';
---
<form class:list={['lead-form','quote-wizard',{compact}]} data-lead-form novalidate>
  <input class="trap" tabindex="-1" autocomplete="off" name="website" aria-hidden="true"/>
  <header class="form-header">
    <p class="eyebrow">Demande de devis · gratuite et sans engagement</p>
    <h2>Étudier votre toiture {titleCity}</h2>
    <p class="form-intro">Environ 3 minutes. Vos réponses servent à préparer un échange concret sur la puissance, le budget et les démarches.</p>
    <ol class="form-progress" aria-label="Progression du formulaire">
      <li class="active" aria-current="step"><span>1</span><b>Projet</b></li><li><span>2</span><b>Toiture</b></li><li><span>3</span><b>Énergie</b></li><li><span>4</span><b>Contact</b></li>
    </ol>
  </header>

  <fieldset data-step="1"><legend>Étape 1 · Quel est votre projet ?</legend>
    <div class="choice-grid">
      <label><input type="radio" name="project" value="Panneaux solaires" checked/><span aria-hidden="true">☀️</span><b>Panneaux solaires</b><small>Autoconsommation et surplus</small></label>
      <label><input type="radio" name="project" value="Panneaux et batterie"/><span aria-hidden="true">🔋</span><b>Solaire + batterie</b><small>Couvrir davantage les soirées</small></label>
      <label><input type="radio" name="project" value="Étude comparative"/><span aria-hidden="true">↗</span><b>Je compare</b><small>3, 6 ou 9 kWc</small></label>
    </div>
    <div class="form-grid"><label>Vous êtes<select required name="ownership"><option value="">Choisir</option><option>Propriétaire occupant</option><option>Propriétaire bailleur</option><option>Acquéreur en cours</option><option>Professionnel / SCI</option></select></label><label>Quand souhaitez-vous avancer ?<select required name="projectTiming"><option value="">Choisir</option><option>Dès que possible</option><option>Dans les 3 mois</option><option>Dans les 6 à 12 mois</option><option>Je me renseigne</option></select></label></div>
  </fieldset>

  <fieldset data-step="2" hidden><legend>Étape 2 · Votre toiture</legend>
    <div class="form-grid"><label>Code postal<input required name="postalCode" pattern="84[0-9]{3}" maxlength="5" inputmode="numeric" placeholder="84000" autocomplete="postal-code"/><small>Le projet doit être situé dans le Vaucluse (84).</small></label><label>Commune<input required name="city" value={city} autocomplete="address-level2" placeholder="Ex. Avignon"/></label><label>Type de toiture<select required name="roofType"><option value="">Choisir</option><option>Tuiles canal</option><option>Tuiles mécaniques</option><option>Toit terrasse</option><option>Bac acier</option><option>Je ne sais pas</option></select></label><label>Surface disponible<select required name="surfaceToiture"><option value="">Choisir</option><option>Moins de 20 m²</option><option>20 à 35 m²</option><option>35 à 55 m²</option><option>Plus de 55 m²</option><option>Je ne sais pas</option></select></label><label>Orientation principale<select required name="orientation"><option value="">Choisir</option><option>Sud</option><option>Sud-est / sud-ouest</option><option>Est / ouest</option><option>Plusieurs pans</option><option>Je ne sais pas</option></select></label><label>Ombres sur le toit<select name="shading"><option>Peu ou pas d’ombre</option><option>Ombres le matin</option><option>Ombres le soir</option><option>Arbres ou bâtiments proches</option><option>Je ne sais pas</option></select></label></div>
    <aside class="form-tip"><b>Pas besoin de monter sur le toit.</b><span>Une estimation suffit à cette étape. La structure, la pente et les masques seront contrôlés lors du relevé technique.</span></aside>
  </fieldset>

  <fieldset data-step="3" hidden><legend>Étape 3 · Vos usages électriques</legend>
    <div class="form-grid"><label>Consommation annuelle<select required name="annualConsumption"><option value="">Choisir</option><option>Moins de 4 000 kWh</option><option>4 000 à 7 000 kWh</option><option>7 000 à 11 000 kWh</option><option>Plus de 11 000 kWh</option><option>Je ne sais pas</option></select></label><label>Facture mensuelle moyenne<select required name="electricityBill"><option value="">Choisir</option><option>Moins de 100 €</option><option>100 à 180 €</option><option>180 à 300 €</option><option>Plus de 300 €</option></select></label></div>
    <p class="field-group-label">Quels équipements consomment surtout en journée ?</p><div class="checkbox-grid"><label><input type="checkbox" name="uses" value="Climatisation"/> Climatisation</label><label><input type="checkbox" name="uses" value="Piscine"/> Piscine</label><label><input type="checkbox" name="uses" value="Ballon électrique"/> Ballon électrique</label><label><input type="checkbox" name="uses" value="Pompe à chaleur"/> Pompe à chaleur</label><label><input type="checkbox" name="uses" value="Véhicule électrique"/> Véhicule électrique</label><label><input type="checkbox" name="uses" value="Télétravail"/> Télétravail</label></div>
    <label class="full-label">Votre priorité<select name="priority"><option>Réduire la facture</option><option>Gagner en autonomie</option><option>Préparer une batterie</option><option>Valoriser la maison</option><option>Comparer les solutions</option></select></label>
  </fieldset>

  <fieldset data-step="4" hidden><legend>Étape 4 · Où envoyer votre étude ?</legend>
    <div class="form-summary" data-summary aria-live="polite"><b>Récapitulatif du projet</b><span>Vos choix apparaîtront ici avant l’envoi.</span></div>
    <div class="form-grid"><label>Prénom<input required name="firstName" autocomplete="given-name"/></label><label>Nom<input required name="lastName" autocomplete="family-name"/></label><label>Téléphone<input required name="phone" inputmode="tel" autocomplete="tel" pattern="(?:\+33|0)[1-9](?:[ .-]?[0-9]{2}){4}" placeholder="06 00 00 00 00"/></label><label>Email<input required type="email" name="email" autocomplete="email" placeholder="vous@exemple.fr"/></label><label class="full">Adresse du projet<input required name="address" autocomplete="street-address" placeholder="Numéro, voie ou lieu-dit"/></label></div>
    <label class="consent"><input required type="checkbox" name="consent"/><span>J’accepte d’être contacté(e) par téléphone par ViteUnDevis.com et ses partenaires afin de qualifier ma demande de devis. <a href="/politique-confidentialite/">Voir les destinataires et la politique de confidentialité</a>.</span></label>
    <p class="legal-hint">Aucune donnée n’est vendue comme fichier de prospection. Consultez la <a href="/politique-confidentialite/">politique de confidentialité</a>.</p>
  </fieldset>

  <div class="form-actions"><button type="button" class="previous" hidden>← Retour</button><span class="step-count">Étape <b>1</b> sur 4</span><button type="button" class="next">Continuer →</button><button type="submit" hidden>Envoyer ma demande →</button></div>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
<script>
  document.querySelectorAll('[data-lead-form]').forEach((form)=>{
    let step=1;
    const panels=[...form.querySelectorAll('[data-step]')], previous=form.querySelector('.previous'), next=form.querySelector('.next'), submit=form.querySelector('[type=submit]'), status=form.querySelector('.form-status'), progress=[...form.querySelectorAll('.form-progress li')], stepCount=form.querySelector('.step-count b'), summary=form.querySelector('[data-summary]');
    const fieldsFor=(panel)=>[...panel.querySelectorAll('input[required],select[required]')];
    const valid=()=>{let ok=true;for(const field of fieldsFor(panels[step-1])){if(!field.checkValidity()){field.reportValidity();ok=false;break;}}return ok};
    const updateSummary=()=>{const data=new FormData(form);summary.innerHTML=`<b>${data.get('project')||'Projet solaire'}</b><span>${data.get('city')||'Commune à préciser'} · ${data.get('postalCode')||''} · ${data.get('roofType')||'Toiture à préciser'} · ${data.get('annualConsumption')||'Consommation à préciser'}</span>`};
    const setStep=(target,shouldScroll=true)=>{step=target;panels.forEach((panel,index)=>panel.hidden=index!==step-1);progress.forEach((item,index)=>{item.classList.toggle('active',index===step-1);item.toggleAttribute('aria-current',index===step-1)});previous.hidden=step===1;next.hidden=step===4;submit.hidden=step!==4;stepCount.textContent=String(step);if(step===4)updateSummary();if(shouldScroll)form.scrollIntoView({behavior:'smooth',block:'center'})};
    next.addEventListener('click',()=>{if(valid())setStep(Math.min(4,step+1))});previous.addEventListener('click',()=>setStep(Math.max(1,step-1)));
    form.addEventListener('submit',async(event)=>{event.preventDefault();if(!valid())return;const button=submit;button.disabled=true;status.className='form-status pending';status.textContent='Envoi sécurisé de votre demande…';const data=Object.fromEntries(new FormData(form));data.uses=[...form.querySelectorAll('[name=uses]:checked')].map((item)=>item.value).join(', ');data.consent=Boolean(form.querySelector('[name=consent]').checked);data.idempotency=crypto.randomUUID();data.pageUrl=location.href;data.consent_timestamp=new Date().toISOString();try{const response=await fetch('/api/lead',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});const body=await response.json();if(!response.ok)throw Error(body.message||body.errors?.[0]||'Une information est à vérifier.');form.reset();setStep(1);status.className='form-status success';status.textContent='Merci. Votre demande a bien été enregistrée ; nous revenons vers vous pour préciser la toiture et les scénarios.'}catch(error){status.className='form-status error';status.textContent=error instanceof Error?error.message:'Une erreur est survenue. Réessayez.'}finally{button.disabled=false}});
    setStep(1,false);
  });
</script>
