---
const {compact=false,city=''}=Astro.props;
const titleCity = city ? `à ${city}` : 'en Vaucluse (84)';
---
<form class:list={['lead-form','steps-form',{compact}]} data-lead-form novalidate>
  <input class="trap" tabindex="-1" autocomplete="off" name="website" aria-hidden="true" />
  <header><p class="eyebrow">Étude gratuite · sans engagement</p><h2>Votre potentiel solaire {titleCity}</h2><p class="form-intro">Trois étapes courtes pour comprendre votre toiture avant de vous recontacter.</p><ol class="form-progress" aria-label="Progression"><li class="active">1. Projet</li><li>2. Toiture</li><li>3. Coordonnées</li></ol></header>
  <fieldset data-step="1"><legend>Étape 1 · Votre projet</legend><div class="choice-grid"><label><input type="radio" name="project" value="Panneaux solaires" checked> <span>☀️</span><b>Panneaux solaires</b><small>Autoconsommation et surplus</small></label><label><input type="radio" name="project" value="Panneaux + batterie"><span>🔋</span><b>Solaire + batterie</b><small>Pour mieux couvrir le soir</small></label><label><input type="radio" name="project" value="Projet à étudier"><span>⌁</span><b>Je compare</b><small>Besoin d’un premier repère</small></label></div><label>Quand souhaitez-vous avancer ?<select name="projectTiming"><option value="Je me renseigne">Je me renseigne</option><option value="Dans les 3 mois">Dans les 3 mois</option><option value="Dès que possible">Dès que possible</option></select></label></fieldset>
  <fieldset data-step="2" hidden><legend>Étape 2 · Votre maison</legend><div class="form-grid"><label>Code postal<input required name="postalCode" pattern="84[0-9]{3}" inputmode="numeric" placeholder="84000" autocomplete="postal-code"></label><label>Ville<input required name="city" value={city} autocomplete="address-level2" placeholder="Ex. Avignon"></label><label>Surface de toiture estimée<select name="surfaceToiture"><option value="Je ne sais pas">Je ne sais pas</option><option value="Moins de 30 m²">Moins de 30 m²</option><option value="30 à 70 m²">30 à 70 m²</option><option value="Plus de 70 m²">Plus de 70 m²</option></select></label><label>Votre toiture<select name="roofType"><option value="À étudier">À étudier</option><option value="Tuiles canal">Tuiles canal</option><option value="Tuiles mécaniques">Tuiles mécaniques</option><option value="Toit terrasse">Toit terrasse</option></select></label></div><aside class="form-tip"><b>Conseil utile</b><span>Une photo de toiture et vos factures permettront ensuite une étude plus précise ; elles ne sont pas demandées ici.</span></aside></fieldset>
  <fieldset data-step="3" hidden><legend>Étape 3 · Recevoir votre étude</legend><div class="form-grid"><label>Prénom<input required name="firstName" autocomplete="given-name"></label><label>Nom<input required name="lastName" autocomplete="family-name"></label><label>Téléphone<input required name="phone" inputmode="tel" autocomplete="tel" placeholder="06 00 00 00 00"></label><label>Email<input required type="email" name="email" autocomplete="email" placeholder="vous@exemple.fr"></label><label class="full">Adresse du projet<input required name="address" autocomplete="street-address" placeholder="Adresse ou lieu-dit"></label></div><label class="consent"><input required type="checkbox" name="consent"> <span>J’accepte que mes coordonnées soient utilisées pour recevoir mon étude solaire et être contacté au sujet de ce projet.</span></label><p class="legal-hint">Vos données sont traitées conformément à notre <a href="/politique-confidentialite/">politique de confidentialité</a>.</p></fieldset>
  <footer class="form-actions"><button type="button" class="previous" hidden>← Retour</button><button type="button" class="next">Continuer →</button><button type="submit" hidden>Recevoir mon étude solaire →</button></footer><p class="form-status" aria-live="polite"></p>
</form>
<script>document.querySelectorAll('[data-lead-form]').forEach((form)=>{let step=1;const steps=[...form.querySelectorAll('[data-step]')],previous=form.querySelector('.previous'),next=form.querySelector('.next'),submit=form.querySelector('[type=submit]'),status=form.querySelector('.form-status'),progress=[...form.querySelectorAll('.form-progress li')];const setStep=(target)=>{step=target;steps.forEach((panel,index)=>{panel.hidden=index!==step-1});progress.forEach((item,index)=>item.classList.toggle('active',index===step-1));previous.hidden=step===1;next.hidden=step===3;submit.hidden=step!==3};const valid=()=>[...steps[step-1].querySelectorAll('input[required],select[required]')].every((field)=>field.reportValidity());next.addEventListener('click',()=>{if(valid())setStep(Math.min(3,step+1))});previous.addEventListener('click',()=>setStep(Math.max(1,step-1)));form.addEventListener('submit',async(event)=>{event.preventDefault();if(!valid())return;const data=Object.fromEntries(new FormData(form));data.consent=Boolean(form.querySelector('[name=consent]').checked);data.idempotency=crypto.randomUUID();data.pageUrl=location.href;status.textContent='Analyse de votre demande…';try{const response=await fetch('/api/lead',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});const body=await response.json();if(!response.ok)throw Error(body.error||body.errors?.[0]||'Une information est à vérifier.');form.reset();setStep(1);status.textContent='Merci — votre étude solaire est en préparation.'}catch(error){status.textContent=error.message}});setStep(1)});</script>
