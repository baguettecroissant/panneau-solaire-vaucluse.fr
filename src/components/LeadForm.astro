---
const {compact=false,city=''}=Astro.props;
const titleCity = city ? `à ${city}` : 'en Vaucluse (84)';
---
<form class:list={['lead-form', {compact}]} data-lead-form><input class="trap" tabindex="-1" autocomplete="off" name="website"><p class="eyebrow">Étude gratuite · sans engagement</p><h2>Votre potentiel solaire {titleCity}</h2><div class="form-grid"><label>Prénom<input required name="firstName" autocomplete="given-name"></label><label>Nom<input required name="lastName" autocomplete="family-name"></label><label>Téléphone<input required name="phone" inputmode="tel" autocomplete="tel"></label><label>Email<input required name="email" type="email" autocomplete="email"></label><label>Adresse<input required name="address" autocomplete="street-address"></label><label>Ville<input required name="city" value={city === 'le Vaucluse' ? '' : city} autocomplete="address-level2"></label><label>Code postal<input required name="postalCode" pattern="84[0-9]{3}" inputmode="numeric" placeholder="84000" autocomplete="postal-code"></label><label>Votre projet<select name="project"><option>Installer des panneaux solaires</option><option>Ajouter une batterie LFP</option><option>Étudier mon autoconsommation</option></select></label></div><label class="consent"><input required type="checkbox" name="consent"> J’accepte que mes coordonnées soient utilisées pour recevoir mon étude solaire.</label><button type="submit">Calculer mon potentiel solaire <span>→</span></button><p class="form-status" aria-live="polite"></p></form><script>document.querySelectorAll('[data-lead-form]').forEach((form)=>form.addEventListener('submit',async(e)=>{e.preventDefault();const status=form.querySelector('.form-status');const data=Object.fromEntries(new FormData(form));data.consent=Boolean(form.querySelector('[name=consent]').checked);data.idempotency=crypto.randomUUID();data.pageUrl=location.href;status.textContent='Analyse de votre demande…';try{const r=await fetch('/api/lead',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});const body=await r.json();if(!r.ok)throw Error(body.error||body.errors?.[0]||'Une information est à vérifier.');form.reset();status.textContent='Merci — votre étude solaire est en préparation.'}catch(error){status.textContent=error.message}}));</script>
