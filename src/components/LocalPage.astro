---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from './LeadForm.astro';
import SolarCalculator from './SolarCalculator.astro';
import SunMap from './SunMap.astro';
import Photo from './Photo.astro';
import communes from '../data/communes.json';
import { guides, localContent } from '../data/editorial.js';
const { city, kind='solar' } = Astro.props;
const index = communes.findIndex((item) => item.slug === city.slug);
const content = localContent(city, index < 0 ? 0 : index);
const installer = kind === 'installer';
const title = installer ? `Installateur solaire RGE à ${city.name} (${city.postalCode}) — Vaucluse` : `Panneaux Solaires à ${city.name} (${city.postalCode}) — Spécialiste Solaire Vaucluse`;
const nearby = communes.filter((item) => item.slug !== city.slug).slice((index + 1) % 18, (index + 1) % 18 + 6);
const related = guides.slice(index % 5, index % 5 + 3);
const photoSlugs=['toiture-solaire','provence-lavande','avignon-pont','mont-ventoux','baux-provence','modules-photovoltaiques'];
const placePhotos={Avignon:'avignon-pont',Orange:'mont-ventoux',Carpentras:'mont-ventoux',Cavaillon:'provence-lavande',Apt:'baux-provence'};
const photoSlug=installer?'poseurs-photovoltaiques':(placePhotos[city.name]||photoSlugs[Math.abs(index)%photoSlugs.length]);
const intentLead=installer?`Vous cherchez un installateur solaire à ${city.name} ? Comparez la qualité de la visite technique, la qualification QualiPV RGE appropriée à vérifier, l’assurance décennale, les fixations et les hypothèses de production avant le prix. ${content.intro}`:`${content.intro} Les projets étudiés dans le 84 se situent habituellement entre ${city.priceMin.toLocaleString('fr-FR')} € et ${city.priceMax.toLocaleString('fr-FR')} € TTC selon le toit, la puissance et les options retenues.`;
const installerFaq=[[`Comment vérifier un installateur solaire à ${city.name} ?`,`Contrôlez l’identité de l’entreprise, sa qualification RGE photovoltaïque active, son assurance décennale et les références exactes portées sur le devis.`],[`La visite technique est-elle obligatoire avant le devis ?`,`Une offre indicative peut précéder la visite, mais le devis définitif doit reposer sur le relevé du toit, des ombres, du tableau électrique et des accès.`],[`Que doit remettre l’installateur après la pose ?`,`Conservez le plan, les fiches techniques, le schéma électrique, les attestations, le procès-verbal de réception, les garanties et les documents de raccordement.`],[`Peut-il sous-traiter le chantier ?`,`Oui, mais le rôle du sous-traitant, sa qualification et son assurance doivent être identifiables avant signature.`],[`Faut-il choisir l’offre la moins chère ?`,`Non. Comparez le périmètre, les fixations, les protections, la production estimée, les garanties, les démarches et le service après-vente.`]];
const faqList=installer?installerFaq:content.faq;
const schema = {'@context':'https://schema.org','@type':'Service',name:title,areaServed:{'@type':'City',name:city.name,postalCode:city.postalCode},serviceType:'Étude photovoltaïque et mise en relation solaire',provider:{'@type':'Organization',name:'Panneau Solaire Vaucluse'}};
---
<BaseLayout title={title} description={`${content.intro} Étude gratuite, production et prix dans le Vaucluse.`}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="local-hero rich-local-hero"><div class="container local-hero-grid"><div><nav class="crumb"><a href="/">Accueil</a><span>›</span><a href="/communes/">Communes</a><span>›</span><span>{city.name}</span></nav><div class="local-badges"><span>📍 {city.postalCode} · Vaucluse</span><span>2 600 h de soleil/an</span><span>Étude sans engagement</span></div><h1>{installer ? `Installateur solaire à ${city.name}` : `Panneaux solaires à ${city.name}`}</h1><p class="lead">{intentLead}</p><div class="hero-actions"><a class="button" href="#devis">{installer?`Comparer des installateurs à ${city.name} →`:`Calculer mon potentiel solaire à ${city.name} →`}</a><a class="text-link light-link" href="#simulateur">Simuler la production</a></div><div class="local-trust"><span><b>{content.production}</b> kWh/kWc/an</span><span><b>{content.sixKwc.toLocaleString('fr-FR')}</b> kWh/an en 6 kWc</span><span><b>3–9</b> kWc à comparer</span></div></div><figure class="local-hero-image"><Photo slug={photoSlug} priority caption/><figcaption>Étude solaire locale · {city.postalCode}</figcaption></figure></div></section>
  <section class="trust-strip"><div class="container"><span>{installer?'✓ RGE photovoltaïque à vérifier':'✓ Modules et références identifiés'}</span><span>{installer?'✓ Décennale et sous-traitance contrôlées':'✓ Pose en surimposition étudiée'}</span><span>{installer?'✓ Visite technique avant devis final':'✓ Onduleur adapté aux ombres'}</span><span>✓ Aucune promesse de rendement</span></div></section>
  {installer&&<section class="section"><div class="container"><div class="section-heading"><p class="eyebrow">Sélection du professionnel</p><h2>Quatre preuves à demander à un installateur de {city.name}.</h2><p>Le badge commercial et le prix ne suffisent pas. La qualité se lit dans les documents, le relevé de toiture et la façon dont l’entreprise explique ses hypothèses.</p></div><div class="feature-grid four"><article><span>01</span><h3>Qualification active</h3><p>Vérifiez le domaine RGE photovoltaïque, la période de validité et l’identité exacte de l’entreprise qui facture.</p></article><article><span>02</span><h3>Assurance adaptée</h3><p>L’attestation décennale doit couvrir l’activité photovoltaïque à la date du chantier, y compris en cas de sous-traitance.</p></article><article><span>03</span><h3>Plan de toiture</h3><p>Exigez le calepinage, les points de fixation, les ombres, les accès et le cheminement électrique.</p></article><article><span>04</span><h3>Hypothèses lisibles</h3><p>Production, autoconsommation, surplus, prix du kWh et aides doivent être datés et séparés.</p></article></div></div></section>}
  <section id="simulateur" class="section"><div class="container"><div class="section-head split"><div><p class="eyebrow">Outil de décision</p><h2>Votre projet à {city.name}, chiffré sans promesse creuse.</h2></div><p>Cette première estimation combine surface, orientation et usages. Elle sert à préparer une visite de toiture, pas à remplacer le relevé technique.</p></div><SolarCalculator city={city.name} yieldPerKwc={content.production} /></div></section>
  <section class="section soft-section"><div class="container editorial-grid"><figure><Photo slug="maison-solaire-aerienne" caption/><figcaption>{city.postalCode} · toiture et intégration</figcaption></figure><article><p class="eyebrow">Toiture & habitat</p><h2>Ce qui change vraiment à {city.name}.</h2><p>{content.roof}</p><p>Le calepinage préserve les rives, les sorties de toiture, les noues et l’accès d’entretien. Sur tuiles canal, l’enjeu est une intégration nette, ventilée et documentée — pas une simple addition de modules.</p><ul class="premium-list"><li>Relevé des ombres à différentes saisons</li><li>Vérification de la structure et du tableau électrique</li><li>Comparaison 3, 6 et 9 kWc sur la même consommation</li><li>Architecture évolutive pour batterie ou véhicule électrique</li></ul></article></div></section>
  <section class="section"><div class="container"><div class="section-head"><p class="eyebrow">Démarches & aides</p><h2>Du premier relevé au raccordement : un parcours lisible.</h2><p>{content.advice}</p></div><div class="timeline-grid"><article><span>01</span><h3>Pré-étude</h3><p>Factures, toiture, ombrage, usages et projets futurs sont mis en regard.</p></article><article><span>02</span><h3>Urbanisme</h3><p>Déclaration préalable à la mairie de {city.name} et vérification des contraintes locales.</p></article><article><span>03</span><h3>Pose</h3><p>Fixations, protections, onduleur, mise à la terre et réception de chantier.</p></article><article><span>04</span><h3>Enedis & surplus</h3><p>Raccordement, documents nécessaires et cadre de valorisation du surplus.</p></article></div><aside class="info-banner"><strong>Point de vigilance 2026</strong><span>Les aides, la TVA et les tarifs de rachat évoluent. Exigez des éléments datés et adaptés à votre installation.</span></aside></div></section>
  <section class="section dark-section"><div class="container heritage-grid"><article><p class="eyebrow gold">Patrimoine & autonomie</p><h2>Une énergie qui respecte le rythme provençal.</h2><p>{content.heritage}</p><p>{content.story}</p><a class="text-link light-link" href="/guide-solaire-mas-provencal/">Découvrir le guide du mas provençal →</a></article><div class="heritage-numbers"><div><strong>2 600 h</strong><span>ensoleillement annuel repère</span></div><div><strong>22 %</strong><span>rendement module moderne indicatif</span></div><div><strong>25 ans</strong><span>horizon de production</span></div><div><strong>84</strong><span>projet ancré dans le Vaucluse</span></div></div></div></section>
  <section class="section"><div class="container"><div class="section-head split"><div><p class="eyebrow">Prix à {city.name}</p><h2>Choisir une puissance pour les usages, pas pour remplir le toit.</h2></div><p>{content.market}</p></div><div class="pricing-grid"><article><span>8 modules environ</span><h3>3 kWc</h3><strong>6 800–9 500 €</strong><p>Maison sobre et consommation surtout en journée.</p><ul><li>≈ {(content.production*3).toLocaleString('fr-FR')} kWh/an</li><li>Autoconsommation progressive</li><li>Surplus valorisable</li></ul></article><article class="popular"><em>Format souvent étudié</em><span>16 modules environ</span><h3>6 kWc</h3><strong>11 500–15 500 €</strong><p>Villa, mas, climatisation, piscine ou télétravail.</p><ul><li>≈ {content.sixKwc.toLocaleString('fr-FR')} kWh/an</li><li>Pilotage ballon / clim</li><li>Batterie possible</li></ul></article><article><span>24 modules environ</span><h3>9 kWc</h3><strong>15 500–21 000 €</strong><p>Grand toit et usages électriques plus importants.</p><ul><li>Production à ajuster au toit</li><li>Option hybride</li><li>Projet évolutif</li></ul></article></div><a class="text-link" href="/tarifs/">Comparer tous les postes de prix →</a></div></section>
  <section class="section soft-section"><div class="container map-grid"><SunMap city={city.name} yieldPerKwc={content.production} /><article><p class="eyebrow">Conseil local</p><h2>Le soleil est une ressource ; le bon dimensionnement en fait un projet.</h2><p>Un toit dégagé ne garantit pas à lui seul une bonne rentabilité. La qualité de l’étude dépend de la consommation, des ombres, de l’état du toit, des usages d’été et de votre horizon de vie dans le logement.</p><a class="button secondary" href="/aides-panneau-solaire-84/">Voir les démarches et aides →</a></article></div></section>
  <section class="section"><div class="container"><div class="section-head"><p class="eyebrow">Questions locales</p><h2>{installer?`FAQ : choisir un installateur solaire à ${city.name}`:`FAQ panneaux solaires à ${city.name}`}</h2></div><div class="faq">{faqList.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
  <section class="section nearby-section"><div class="container"><div class="section-head split"><div><p class="eyebrow">Autour de {city.name}</p><h2>Étudier le solaire dans les communes voisines.</h2></div><a class="text-link" href="/communes/">Toutes les communes du 84 →</a></div><div class="nearby-grid">{nearby.map((place) => <a href={`/${installer?'installateur-solaire':'panneau-solaire'}-${place.slug}/`}><span>📍 {place.postalCode}</span><strong>{installer?'Installateur solaire':'Panneaux solaires'} à {place.name}</strong><small>Production, prix, toiture et étude locale →</small></a>)}</div><div class="guide-links"><a href={`/${installer?'panneau-solaire':'installateur-solaire'}-${city.slug}/`}>{installer?'Voir le potentiel solaire':'Choisir un installateur'} à {city.name} →</a>{related.map((guide) => <a href={`/guides/${guide.slug}/`}>{guide.shortTitle} →</a>)}<a href="/aides-panneau-solaire-84/">Aides solaires 2026 dans le 84 →</a></div></div></section>
  <section id="devis" class="section lead-section"><div class="container"><LeadForm city={city.name} /></div></section>
</BaseLayout>
