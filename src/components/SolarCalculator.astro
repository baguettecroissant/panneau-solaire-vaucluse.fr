---
const {city='Vaucluse', yieldPerKwc=1300, compact=false}=Astro.props;
---
<div class:list={['solar-calculator',{compact}]} data-solar-calculator data-yield={yieldPerKwc}>
  <div class="calculator-copy"><p class="eyebrow">Simulateur solaire</p><h2>Votre toiture en quelques chiffres.</h2><p>Un premier repère local pour discuter puissance, production et retour sur investissement. Une étude technique reste indispensable avant toute décision.</p><ul><li>Production estimée selon orientation</li><li>Budget et économies sur 25 ans</li><li>Compatible mas, villa et résidence secondaire</li></ul></div>
  <form><label>Surface disponible <output data-surface-output>45 m²</output><input name="surface" type="range" min="15" max="130" value="45" step="5"></label><label>Orientation <select name="orientation"><option value="1">Sud · optimale</option><option value=".91">Sud-est / sud-ouest</option><option value=".78">Est / ouest</option></select></label><label>Consommation annuelle <select name="consumption"><option value="5500">5 500 kWh · foyer standard</option><option value="8000" selected>8 000 kWh · villa / clim</option><option value="11500">11 500 kWh · piscine / VE</option></select></label></form>
  <div class="calc-result" aria-live="polite"><span>Potentiel recommandé</span><strong data-kwc>6,0 kWc</strong><div><b data-production>7 800 kWh/an</b><small>production indicative à {city}</small></div><div><b data-roi>10–13 ans</b><small>retour indicatif selon économies</small></div><a href="#devis" class="button">Recevoir une étude précise →</a></div>
</div>
<script>document.querySelectorAll('[data-solar-calculator]').forEach((card)=>{const form=card.querySelector('form'),surface=form.elements.surface,orientation=form.elements.orientation,consumption=form.elements.consumption,yieldPerKwc=Number(card.dataset.yield);const out=card.querySelector('[data-surface-output]'),kwc=card.querySelector('[data-kwc]'),production=card.querySelector('[data-production]'),roi=card.querySelector('[data-roi]');const update=()=>{const p=Math.min(9,Math.max(3,Number(surface.value)/7.5));const annual=Math.round(p*yieldPerKwc*Number(orientation.value));const years=Math.max(7,Math.round((p*2100)/(Math.min(annual,Number(consumption.value))*.22)));out.value=`${surface.value} m²`;kwc.textContent=`${p.toFixed(1).replace('.',',')} kWc`;production.textContent=`${annual.toLocaleString('fr-FR')} kWh/an`;roi.textContent=`${years}–${years+3} ans`};form.addEventListener('input',update);update()});</script>
