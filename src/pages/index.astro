---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import SolarCalculator from '../components/SolarCalculator.astro';
import SunMap from '../components/SunMap.astro';
import Photo from '../components/Photo.astro';
import communes from '../data/communes.json';
import { guides } from '../data/editorial.js';
---
<BaseLayout title="Panneaux Solaires Vaucluse (84) — Étude gratuite 2026" description="Panneaux solaires, autonomie énergétique et devis gratuits dans le Vaucluse. Étude locale pour mas provençaux et villas.">
  <section class="hero premium-hero"><div class="container hero-grid"><div class="hero-copy"><p class="sun-badge">☀ 2 600 h de soleil/an — la Provence solaire par nature</p><p class="eyebrow">Panneaux solaires · Vaucluse 84</p><h1>Le soleil de Provence,<br/><i>votre autonomie.</i></h1><p class="lead">Du mas en pierre dorée à la villa familiale, donnez une nouvelle utilité à votre toiture. Production, pilotage des usages et étude locale, sans discours opaque.</p><div class="hero-actions"><a class="button" href="#etude">Estimer mon installation <span>→</span></a><a class="text-link light-link" href="/tarifs/">Voir les prix 2026</a></div><div class="hero-data"><div><strong>2 600 h</strong><span>soleil annuel repère</span></div><div><strong>6 kWc</strong><span>format mas & villa</span></div><div><strong>25 ans</strong><span>horizon de production</span></div></div></div><figure class="hero-visual"><Photo slug="provence-lavande" priority caption/><figcaption><span>ÉTUDE LOCALE</span><b>Vaucluse · 84</b><small>Toiture, production, usages</small></figcaption></figure></div></section>
  <section class="trust-strip"><div class="container"><span>✓ Étude de toiture</span><span>✓ Projet mas, villa ou résidence secondaire</span><span>✓ Production et prix expliqués</span><span>✓ Sans engagement</span></div></section>
  <section class="section"><div class="container intro-grid"><article><p class="eyebrow">La méthode provençale</p><h2>Une étude qui regarde vraiment votre toiture.</h2><p>Le rendement dépend de l’orientation, de la pente, des ombres et de vos usages. Dans le Vaucluse, climatisation, piscine, ballon d’eau chaude et résidences secondaires changent souvent le bon dimensionnement.</p><p>Nous commençons par des questions simples : quelle énergie consommez-vous en journée, que voulez-vous piloter et comment votre toit vit-il au fil des saisons ?</p><a class="text-link" href="/guide-solaire-mas-provencal/">Le guide du mas solaire →</a><a class="text-link" href="/aides-panneau-solaire-84/">Aides et démarches 2026 →</a></article><div class="method-cards"><article><span>01</span><h3>Votre toiture</h3><p>Surface, tuiles canal, ombrage, orientation et accès.</p></article><article><span>02</span><h3>Votre rythme</h3><p>Climatisation, piscine, télétravail, absences et ballon.</p></article><article><span>03</span><h3>Votre projet</h3><p>Autoconsommation, surplus, batterie ou véhicule électrique.</p></article></div></div></section>
  <section class="section soft-section"><div class="container"><div class="section-head split"><div><p class="eyebrow">Simulateur solaire</p><h2>Un premier chiffre pour préparer les bonnes questions.</h2></div><p>Surface, orientation, consommation : ajustez les paramètres et recevez un ordre de grandeur avant une analyse de toiture détaillée.</p></div><SolarCalculator /></div></section>
  <section class="section dark-section"><div class="container power-story"><div><p class="eyebrow gold">Des repères simples</p><h2>Quelle puissance pour votre maison ?</h2><p>Une installation bien pensée ne cherche pas à couvrir le toit : elle cherche à produire une énergie consommée au bon moment, avec une architecture qui peut évoluer.</p></div><div class="price-cards"><article><span>8 modules environ</span><h3>3 kWc</h3><p>Maison compacte et consommation maîtrisée.</p><strong>6 800 – 9 500 €</strong></article><article class="featured"><em>Le format le plus étudié</em><span>16 modules environ</span><h3>6 kWc</h3><p>Villa ou mas, usages de journée et confort d’été.</p><strong>11 500 – 15 500 €</strong></article><article><span>24 modules environ</span><h3>9 kWc</h3><p>Grand toit, climatisation, piscine ou véhicule électrique.</p><strong>15 500 – 21 000 €</strong></article></div><a class="button light-button" href="/tarifs/">Comparer les puissances →</a></div></section>
  <section class="section"><div class="container map-grid"><SunMap /><article><p class="eyebrow">Vaucluse, une géographie solaire</p><h2>Du Ventoux au Luberon, la lumière ne suffit pas : le détail du toit compte.</h2><p>Les villages perchés, les mas de plaine et le tissu urbain d’Avignon ne se dimensionnent pas de la même manière. Le mistral, les arbres, les cheminées, les pans de toiture et le patrimoine local font partie de l’étude.</p><a class="button secondary" href="/communes/">Trouver ma commune →</a></article></div></section>
  <section class="section communes-preview"><div class="container"><div class="section-head split"><div><p class="eyebrow">Près de chez vous</p><h2>Le solaire dans tout le Vaucluse.</h2></div><a class="text-link" href="/communes/">Voir les communes du 84 →</a></div><div class="commune-cards">{communes.slice(0,12).map((city)=><a href={`/panneau-solaire-${city.slug}/`}><span>{city.postalCode}</span><strong>{city.name}</strong><small>Production, prix et étude locale →</small></a>)}</div></div></section>
  <section class="section soft-section"><div class="container"><div class="section-head split"><div><p class="eyebrow">Guides pratiques</p><h2>Décider avec des informations utiles.</h2></div><a class="text-link" href="/guides/">Voir tous les guides →</a></div><div class="guide-preview-grid">{guides.slice(0,3).map((guide)=><a href={`/guides/${guide.slug}/`}><img src={guide.heroImage} alt={`Photographie pour le guide : ${guide.shortTitle}`} width="1600" height="1000"/><div><span>{guide.category} · {guide.readTime}</span><h3>{guide.title}</h3><p>{guide.intro}</p><strong>Lire le guide →</strong></div></a>)}</div></div></section>
  <section id="etude" class="section lead-section"><div class="container quote-section"><div><p class="eyebrow">Votre étude offerte</p><h2>Et si votre toit produisait dès cet été ?</h2><p>Décrivez le projet. Nous vous aidons à situer le potentiel, le budget, les démarches et les étapes utiles avant de demander un devis détaillé.</p><ul class="premium-list"><li>Projet vérifié dans le Vaucluse</li><li>Réponse adaptée à votre toiture</li><li>Pas de promesse d’autonomie irréaliste</li></ul></div><LeadForm compact /></div></section>
</BaseLayout>
