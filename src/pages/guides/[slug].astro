---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { guides } from '../../data/editorial.js';
export function getStaticPaths(){return guides.map((guide,index)=>({params:{slug:guide.slug},props:{guide,index}}));}
const { guide, index } = Astro.props;
const related = guide.relatedSlugs.map((slug)=>guides.find((item)=>item.slug===slug)).filter(Boolean);
const schema={'@context':'https://schema.org','@type':'Article',headline:guide.title,image:`https://panneau-solaire-vaucluse.fr${guide.heroImage}`,author:{'@type':'Organization',name:'Panneau Solaire Vaucluse'},mainEntityOfPage:`https://panneau-solaire-vaucluse.fr/guides/${guide.slug}/`};
---
<BaseLayout title={`${guide.title} — Panneau Solaire Vaucluse`} description={guide.intro}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="article-hero"><div class="container article-hero-grid"><div><nav class="crumb"><a href="/">Accueil</a><span>›</span><a href="/guides/">Guides</a><span>›</span><span>{guide.shortTitle}</span></nav><p class="eyebrow gold">{guide.category} · {guide.readTime}</p><h1>{guide.title}</h1><p class="lead">{guide.intro}</p><div class="article-meta"><span>Mis à jour en 2026</span><span>Données Vaucluse</span><span>Lecture claire, sans promesse de rendement</span></div></div><figure><img src={guide.heroImage} alt={`Illustration : ${guide.title}`} width="1600" height="1000"/><figcaption>Guide solaire Vaucluse · {guide.category}</figcaption></figure></div></section>
  <section class="section article-section"><div class="container article-layout"><aside class="article-toc"><strong>Dans ce guide</strong><ol>{guide.sections.map((section,i)=><li><a href={`#section-${i+1}`}>{section.heading}</a></li>)}</ol><a class="button" href="/devis/">Étudier mon projet</a><a href="/tarifs/">Voir les prix 2026</a></aside><article class="article-body"><div class="article-intro"><span>En bref</span><p>{guide.intro}</p></div>{guide.sections.map((section,i)=><section id={`section-${i+1}`}><span class="section-number">0{i+1}</span><h2>{section.heading}</h2>{section.paragraphs.map((paragraph)=><p>{paragraph}</p>)}{section.bullets&&<ul class="premium-list">{section.bullets.map((bullet)=><li>{bullet}</li>)}</ul>}{i===1&&<div class="article-cta"><div><strong>Votre maison est-elle adaptée ?</strong><span>Recevez une première lecture de toiture et de consommation, sans engagement.</span></div><a href="/devis/">Simulation gratuite →</a></div>}</section>)}<section class="article-faq"><p class="eyebrow">Questions fréquentes</p><h2>Ce qu’il faut retenir.</h2><div class="faq">{guide.faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></section></article></div></section>
  <section class="section soft-section"><div class="container"><div class="section-head split"><div><p class="eyebrow">À lire ensuite</p><h2>Approfondir votre projet solaire.</h2></div><a class="text-link" href="/guides/">Tous les guides →</a></div><div class="related-guides">{related.map((item)=><a href={`/guides/${item.slug}/`}><img src={item.heroImage} alt="" loading="lazy" width="1600" height="1000"/><div><span>{item.category}</span><strong>{item.title}</strong><small>Lire en {item.readTime} →</small></div></a>)}</div></div></section>
  <section class="section lead-section"><div class="container"><LeadForm compact /></div></section>
</BaseLayout>
