---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import Photo from '../../components/Photo.astro';
import photos from '../../data/photos.json';
import { guides } from '../../data/editorial.js';
export function getStaticPaths(){return guides.map((guide,index)=>({params:{slug:guide.slug},props:{guide,index}}));}
const {guide,index}=Astro.props;
const related=guide.relatedSlugs.map((slug)=>guides.find((item)=>item.slug===slug)).filter(Boolean);
const heroSlug=photos.find((photo)=>photo.src===guide.heroImage)?.slug||'provence-lavande';
const sectionPhotos=['maison-solaire-aerienne','poseurs-photovoltaiques','modules-photovoltaiques','mont-ventoux','baux-provence','avignon-pont'];
const practical={
 'prix-panneaux-solaires-vaucluse-2026':['Prix TTC avant et après aides vérifiées','Références exactes des modules et de l’onduleur','Production, autoconsommation et surplus séparés','Échafaudage, urbanisme, Enedis et Consuel listés','Garanties produit, performance et pose distinguées','Scénario 3, 6 et 9 kWc sur les mêmes hypothèses'],
 'solaire-mas-provencal-vaucluse':['État de la charpente et des tuiles canal','Plan coté avec rives, noues et accès','Système de fixation identifié','Visibilité depuis cour, accès et voie publique','Contraintes d’urbanisme vérifiées avant commande','Dimensionnement du vent adapté au bâtiment'],
 'autoconsommation-solaire-84':['Courbe de consommation sur une année','Usages déplaçables entre 10 h et 17 h','Production mensuelle, pas seulement annuelle','Taux d’autoconsommation justifié','Surplus et vente expliqués','Batterie comparée à un pilotage simple'],
 'aides-panneaux-solaires-vaucluse':['Nom officiel et source du dispositif','Barème daté au jour de la demande','Qualification RGE active et appropriée','Ordre exact entre signature, dossier et travaux','TVA justifiée sur le devis','Conséquence écrite en cas de refus'],
 'panneaux-solaires-climatisation-vaucluse':['Puissance et horaires réels de la climatisation','Protection solaire et isolation déjà examinées','Production solaire comparée au besoin d’été','Consigne et pilotage simples','Piscine et ballon inclus dans le profil','Usages du soir séparés des usages de journée'],
 'batterie-solaire-provence':['Capacité utile en kWh, pas seulement nominale','Puissance de charge et de décharge','Rendement aller-retour','Garantie en années et cycles','Mode secours réellement câblé ou non','Comparaison économique avec vente du surplus'],
 'residence-secondaire-solaire-vaucluse':['Occupation mois par mois','Équipements pilotables pendant les absences','Connexion disponible pour le suivi','Responsable local en cas d’alerte','Surplus produit hors séjour','Puissance limitée aux usages réellement valorisés'],
 'installateur-rge-qualipv-vaucluse':['Qualification vérifiée dans l’annuaire officiel','Décennale couvrant précisément le photovoltaïque','Visite technique avant offre définitive','Sous-traitant identifié et assuré','Plan, schéma et hypothèses remis','SAV, interlocuteur et délais écrits']
};
const checks=practical[guide.slug]||practical['prix-panneaux-solaires-vaucluse-2026'];
const schema={'@context':'https://schema.org','@type':'Article',headline:guide.title,description:guide.intro,image:`https://panneau-solaire-vaucluse.fr${guide.heroImage}`,author:{'@type':'Organization',name:'Panneau Solaire Vaucluse'},dateModified:'2026-07-26',mainEntityOfPage:`https://panneau-solaire-vaucluse.fr/guides/${guide.slug}/`};
---
<BaseLayout title={`${guide.title} — Panneau Solaire Vaucluse`} description={guide.intro} image={guide.heroImage} schema={schema}>
 <section class="content-hero article-photo-hero"><div class="container hero-split"><div><nav class="crumb"><a href="/">Accueil</a><span>›</span><a href="/guides/">Guides</a><span>›</span><span>{guide.shortTitle}</span></nav><p class="eyebrow">{guide.category} · {guide.readTime}</p><h1>{guide.title}</h1><p class="lead">{guide.intro}</p><div class="article-meta"><span>Mis à jour en juillet 2026</span><span>Contexte Vaucluse</span><span>Hypothèses transparentes</span></div></div><Photo slug={heroSlug} priority caption/></div></section>

 <section class="section"><div class="container article-shell"><aside class="article-aside"><strong>Dans ce guide</strong><ol>{guide.sections.map((section,i)=><li><a href={`#section-${i+1}`}>{section.heading}</a></li>)}</ol><a href="#checklist">Checklist pratique</a><a href="#faq">Questions fréquentes</a><a class="button" href="#devis">Étudier mon projet</a></aside><article class="prose">
  <div class="article-intro"><span>En bref</span><p>{guide.intro}</p></div>
  {guide.sections.map((section,i)=><section id={`section-${i+1}`}><span class="section-number">0{i+1}</span><h2>{section.heading}</h2>{section.paragraphs.map((paragraph)=><p>{paragraph}</p>)}{section.bullets&&<ul class="check-list">{section.bullets.map((bullet)=><li>{bullet}</li>)}</ul>}{i===0&&<div class="callout"><b>Le réflexe utile</b><p>Demandez toujours la donnée source, l’hypothèse de calcul et la conséquence concrète sur votre toiture. Une affirmation impossible à expliquer ne doit pas guider une décision à plusieurs milliers d’euros.</p></div>}{i===1&&<Photo slug={sectionPhotos[index%sectionPhotos.length]} caption/>}{i===2&&<div class="article-cta"><div><strong>Comparer sur une base identique</strong><span>Toiture, consommation, production, matériel et démarches doivent rester constants d’un scénario à l’autre.</span></div><a href="/devis/">Préparer l’étude →</a></div>}</section>)}
  <section id="checklist"><p class="eyebrow">Outil de décision</p><h2>La checklist à garder devant vous.</h2><p>Ces six points transforment une discussion commerciale en comparaison vérifiable. Demandez qu’ils apparaissent dans l’étude ou dans le devis, avec les documents associés.</p><div class="checklist-panel">{checks.map((check,i)=><div><b>{String(i+1).padStart(2,'0')}</b><span>{check}</span></div>)}</div><div class="callout"><b>À conserver après la pose</b><p>Le devis signé, le plan d’implantation, les fiches techniques, le schéma électrique, les attestations, le procès-verbal de réception, les accès de suivi et les documents de raccordement.</p></div></section>
  <section><p class="eyebrow">Mettre les chiffres à l’épreuve</p><h2>Trois questions qui évitent les projections trop belles.</h2><ol class="number-list"><li><b>D’où vient ce chiffre ?</b><span>Logiciel, données météo, orientation, ombres, pertes et année de référence doivent être identifiables.</span></li><li><b>Qu’est-ce qui change si l’usage réel diffère ?</b><span>Demandez un scénario prudent et un scénario central, pas une seule courbe parfaite.</span></li><li><b>Qui prend en charge chaque étape ?</b><span>Urbanisme, raccordement, conformité, aide éventuelle et SAV doivent avoir un responsable écrit.</span></li></ol></section>
  <section id="faq"><p class="eyebrow">Questions fréquentes</p><h2>Les réponses à vérifier avant de signer.</h2><div class="faq">{guide.faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
 </article></div></section>

 <section class="section soft-section"><div class="container"><div class="section-heading"><p class="eyebrow">À lire ensuite</p><h2>Construire votre parcours de décision.</h2><p>Chaque guide répond à une intention précise : budget, toiture, usages, stockage, aides ou choix du professionnel.</p></div><div class="related-guides">{related.map((item)=>{const slug=photos.find((photo)=>photo.src===item.heroImage)?.slug||'provence-lavande';return <a href={`/guides/${item.slug}/`}><Photo slug={slug}/><div><span>{item.category}</span><strong>{item.title}</strong><small>Lire en {item.readTime} →</small></div></a>})}</div><div class="related-links section-links"><a href="/tarifs/"><b>Comparer les prix</b><span>3, 6 et 9 kWc sur une base commune.</span></a><a href="/aides-panneau-solaire-84/"><b>Vérifier les aides</b><span>Calendrier, RGE et sources officielles.</span></a><a href="/communes/"><b>Votre commune</b><span>Toiture, contexte et liens locaux.</span></a></div></div></section>

 <section class="section lead-section" id="devis"><div class="container quote-section"><div><p class="eyebrow">Passer du guide à votre toiture</p><h2>Préparez une comparaison adaptée à votre maison.</h2><p>Le formulaire recueille les éléments qui changent réellement le dimensionnement : couverture, surface, orientation, consommation et usages.</p><ul class="check-list"><li>Réponse ancrée dans le Vaucluse</li><li>Puissances et hypothèses comparables</li><li>Aucun engagement de signature</li></ul></div><LeadForm compact/></div></section>
</BaseLayout>
