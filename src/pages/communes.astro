---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import communes from '../data/communes.json';
const anchors=['Avignon','Carpentras','Orange','Cavaillon','L\'Isle-sur-la-Sorgue','Pertuis','Apt','Vaison-la-Romaine'];
const featured=anchors.map((name)=>communes.find((c)=>c.name===name)).filter(Boolean);
const groups=[
 {name:'Grand Avignon et plaine du Rhône',intro:'Toitures urbaines, villas de lotissement, mas en périphérie et contraintes patrimoniales autour d’Avignon.',match:(c)=>['Avignon','Le Pontet','Sorgues','Vedène','Morières-lès-Avignon','Caumont-sur-Durance','Saint-Saturnin-lès-Avignon','Entraigues-sur-la-Sorgue','Châteauneuf-de-Gadagne','Bédarrides'].includes(c.name)},
 {name:'Comtat Venaissin et Ventoux',intro:'Maisons de plaine, villages de piémont, mistral et relief demandent une lecture précise de l’exposition.',match:(c)=>['Carpentras','Monteux','Mazan','Aubignan','Pernes-les-Fontaines','Malaucène','Beaumes-de-Venise','Saint-Didier','Venasque','Mormoiron','Bédoin','Aurel','Sault'].includes(c.name)},
 {name:'Luberon, Apt et pays des Sorgues',intro:'Mas, pierre, tuiles canal, villages perchés et résidences secondaires donnent une place importante à l’intégration.',match:(c)=>['Cavaillon','L\'Isle-sur-la-Sorgue','Apt','Le Thor','Velleron','Cabrières-d\'Avignon','Gordes','Bonnieux','Lourmarin','Cucuron','Roussillon','Saint-Saturnin-lès-Apt','Cheval-Blanc','Robion','Maubec','Oppède','Mérindol','Puget','Lauris'].includes(c.name)},
 {name:'Nord Vaucluse, Orange et Enclave',intro:'Mistral, grandes toitures, vignobles et villes du couloir rhodanien structurent les projets du nord du département.',match:(c)=>['Orange','Bollène','Vaison-la-Romaine','Châteauneuf-du-Pape','Courthézon','Sainte-Cécile-les-Vignes','Camaret-sur-Aigues','Piolenc','Lapalud','Mornas','Caderousse','Jonquières','Uchaux','Mondragon','Valréas','Grillon','Visan','Sablet','Séguret','Rasteau','Cairanne','Gigondas','Vacqueyras','Suze-la-Rousse'].includes(c.name)},
 {name:'Sud Luberon et pays d’Aigues',intro:'Villas, villages provençaux et influence méditerranéenne : la consommation d’été compte souvent dans le dimensionnement.',match:(c)=>['Pertuis','Ansouis','Villelaure','La Tour-d\'Aigues','Cadenet','La Bastide-des-Jourdans','Grambois','Mirabeau'].includes(c.name)}
];
const assigned=new Set(groups.flatMap((g)=>communes.filter(g.match).map((c)=>c.slug)));
const others=communes.filter((c)=>!assigned.has(c.slug));
---
<BaseLayout title="Panneaux solaires dans le Vaucluse — 75 communes" description="Trouvez les pages locales panneaux solaires et installateurs RGE pour 75 communes du Vaucluse, du Grand Avignon au Luberon et au Ventoux." image="/images/photos/mont-ventoux.webp">
 <section class="content-hero photo-hero"><div class="container hero-split"><div><nav class="crumb"><a href="/">Accueil</a><span>›</span><span>Communes du Vaucluse</span></nav><p class="eyebrow">Annuaire local · département 84</p><h1>Étudier le solaire commune par commune, sans oublier le toit.</h1><p class="lead">Le productible régional est favorable, mais l’orientation, les ombres, la couverture et les règles d’urbanisme restent locales. Sélectionnez votre commune pour préparer le bon scénario.</p><div class="hero-actions"><a class="button" href="#annuaire">Trouver ma commune →</a><a class="text-link" href="/devis/">Demander une étude</a></div></div><Photo slug="mont-ventoux" priority caption/></div></section>
 <section class="section"><div class="container"><div class="section-heading"><p class="eyebrow">Principaux bassins de vie</p><h2>Commencer par les villes les plus recherchées.</h2></div><div class="featured-local-grid">{featured.map((city,index)=><article><Photo slug={['avignon-pont','toiture-solaire','provence-lavande','baux-provence'][index%4]}/><div><span>{city.postalCode}</span><h2>{city.name}</h2><p>{city.localAngle}.</p><div><a href={`/panneau-solaire-${city.slug}/`}>Étude solaire →</a><a href={`/installateur-solaire-${city.slug}/`}>Installateur →</a></div></div></article>)}</div></div></section>
 <section id="annuaire" class="section soft-section"><div class="container"><div class="section-heading"><p class="eyebrow">75 communes</p><h2>Explorer le Vaucluse par territoire.</h2><p>Chaque fiche relie la production, les formats de toiture, les prix, les démarches et les communes voisines. Les pages « installateur » ajoutent les contrôles RGE, décennale et visite technique.</p></div><div class="territory-list">{groups.map((group)=><section><header><h2>{group.name}</h2><p>{group.intro}</p></header><div class="directory-grid">{communes.filter(group.match).map((city)=><article><span>{city.postalCode}</span><h3>{city.name}</h3><p>{city.marketNote}.</p><div><a href={`/panneau-solaire-${city.slug}/`}>Panneaux solaires</a><a href={`/installateur-solaire-${city.slug}/`}>Installateur RGE</a></div></article>)}</div></section>)}{others.length>0&&<section><header><h2>Autres communes couvertes</h2><p>Accédez aux études locales complémentaires du département.</p></header><div class="directory-grid">{others.map((city)=><article><span>{city.postalCode}</span><h3>{city.name}</h3><p>{city.marketNote}.</p><div><a href={`/panneau-solaire-${city.slug}/`}>Panneaux solaires</a><a href={`/installateur-solaire-${city.slug}/`}>Installateur RGE</a></div></article>)}</div></section>}</div></div></section>
 <section class="section"><div class="container editorial-split"><Photo slug="avignon-pont" caption/><article><p class="eyebrow">Bien utiliser ces pages</p><h2>Une commune donne le contexte ; seule votre toiture donne le projet.</h2><p>Les fiches locales servent à comprendre les ordres de grandeur, les types d’habitat et les étapes habituelles. Elles ne remplacent ni l’étude des ombres, ni le contrôle de la charpente, ni la consultation des règles d’urbanisme applicables à votre adresse.</p><ul class="check-list"><li>Comparer plusieurs puissances avec les mêmes hypothèses</li><li>Vérifier la qualification et l’assurance du professionnel</li><li>Demander un plan d’implantation, pas seulement une puissance</li><li>Faire dater les aides et les tarifs de surplus annoncés</li></ul><div class="related-links"><a href="/tarifs/"><b>Prix et puissances</b><span>3, 6 et 9 kWc comparés.</span></a><a href="/aides-panneau-solaire-84/"><b>Aides 2026</b><span>Le calendrier des démarches.</span></a></div></article></div></section>
</BaseLayout>
