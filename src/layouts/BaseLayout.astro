---
import '../styles/global.css';
import { site, nav } from '../data/site.js';
const {title=`${site.name} — Devis gratuits`,description='Panneaux solaires, autonomie énergétique et étude gratuite dans le Vaucluse.',canonical} = Astro.props;
const url=canonical || new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content={description}><link rel="canonical" href={url}><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🌅%3C/text%3E%3C/svg%3E"><title>{title}</title></head><body><header class="site-header"><a class="brand" href="/" aria-label="Panneau Solaire Vaucluse"><span>🌅</span><b>Panneau Solaire<br><em>Vaucluse</em></b></a><nav>{nav.map(([label,href])=><a href={href}>{label}</a>)}</nav><a class="header-cta" href="/devis/">Mon étude solaire</a></header><main><slot /></main><footer><section><a class="brand footer-brand" href="/"><span>🌅</span><b>Panneau Solaire<br><em>Vaucluse</em></b></a><p>La Provence solaire, avec une étude locale claire et sans engagement.</p></section><section><h2>Explorer</h2><a href="/communes/">Toutes les communes</a><a href="/tarifs/">Prix & rendement</a><a href="/guides/prix-panneaux-solaires-vaucluse-2026/">Guides solaires</a></section><section><h2>Informations</h2><a href="/mentions-legales/">Mentions légales</a><a href="/politique-confidentialite/">Confidentialité</a><a href="/devis/">Demander une étude</a></section></footer></body></html>
