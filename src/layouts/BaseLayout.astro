---
import '../styles/global.css';
import { site, nav } from '../data/site.js';
const {title=`${site.name} — Devis gratuits`,description='Panneaux solaires, autonomie énergétique et étude gratuite dans le Vaucluse.',canonical,image='/images/photos/provence-lavande.webp',schema} = Astro.props;
const url=canonical || new URL(Astro.url.pathname, Astro.site).href;
const imageUrl=new URL(image,Astro.site).href;
const defaultSchema={'@context':'https://schema.org','@type':'WebSite',name:site.name,url:'https://panneau-solaire-vaucluse.fr'};
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content={description}/>
  <meta name="robots" content="index,follow,max-image-preview:large"/>
  <link rel="canonical" href={url}/>
  <meta property="og:type" content="website"/><meta property="og:locale" content="fr_FR"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={url}/><meta property="og:image" content={imageUrl}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🌅%3C/text%3E%3C/svg%3E"/>
  <script type="application/ld+json" set:html={JSON.stringify(schema||defaultSchema)} />
  <title>{title}</title>
</head>
<body>
  <a class="skip-link" href="#contenu">Aller au contenu</a>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Panneau Solaire Vaucluse — accueil"><span aria-hidden="true">🌅</span><b>Panneau Solaire<br/><em>Vaucluse</em></b></a>
    <nav aria-label="Navigation principale">{nav.map(([label,href])=><a href={href}>{label}</a>)}</nav>
    <a class="header-cta" href="/devis/">Étude solaire gratuite</a>
    <details class="mobile-menu"><summary aria-label="Ouvrir le menu">Menu</summary><nav>{nav.map(([label,href])=><a href={href}>{label}</a>)}<a href="/devis/">Demander une étude</a></nav></details>
  </header>
  <main id="contenu"><slot /></main>
  <aside class="mobile-sticky-cta" data-mobile-sticky-cta aria-hidden="true">
    <span><small>Étude gratuite</small><strong>Mon devis solaire</strong></span>
    <a href={Astro.url.pathname==='/devis/'?'#formulaire':'/devis/#formulaire'}>Démarrer <span aria-hidden="true">→</span></a>
  </aside>
  <footer class="site-footer">
    <div class="footer-inner">
      <section><a class="brand footer-brand" href="/"><span>🌅</span><b>Panneau Solaire<br/><em>Vaucluse</em></b></a><p>Des repères clairs pour étudier un projet photovoltaïque dans le Vaucluse, sans promesse irréaliste.</p></section>
      <section><h2>Votre projet</h2><a href="/tarifs/">Prix 3, 6 et 9 kWc</a><a href="/aides-panneau-solaire-84/">Aides et démarches</a><a href="/devis/">Étude solaire gratuite</a></section>
      <section><h2>Explorer</h2><a href="/communes/">Communes du Vaucluse</a><a href="/guides/">Guides solaires</a><a href="/guide-solaire-mas-provencal/">Solaire sur un mas</a></section>
      <section><h2>Informations</h2><a href="/mentions-legales/">Mentions légales</a><a href="/politique-confidentialite/">Confidentialité</a><a href="/credits-photos/">Crédits photos</a></section>
    </div>
  </footer>
  <script>
    const stickyCta=document.querySelector('[data-mobile-sticky-cta]');
    if(stickyCta){
      const updateStickyCta=()=>{
        const footer=document.querySelector('.site-footer');
        const footerNear=footer&&footer.getBoundingClientRect().top<window.innerHeight+80;
        const visible=window.scrollY > 320&&!footerNear;
        stickyCta.classList.toggle('is-visible',visible);
        stickyCta.setAttribute('aria-hidden',String(!visible));
      };
      addEventListener('scroll',updateStickyCta,{passive:true});
      addEventListener('resize',updateStickyCta,{passive:true});
      updateStickyCta();
    }
  </script>
</body>
</html>
